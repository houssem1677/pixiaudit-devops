{
  "audits": {
    "seo":         true,
    "performance": true,
    "security":    true
  },
  "crawler": {
    "max_pages":         50,
    "timeout_sec":       10,
    "delay_ms":          500,
    "respect_robots_txt": true,
    "max_depth":         5,
    "concurrency":       3,
    "auth": {
      "enabled":        false,
      "login_url":      "",
      "username":       "",
      "password":       "",
      "username_field": "username",
      "password_field": "password"
    }
  },
  "seo": {
    "title_min_length":      50,
    "title_max_length":      60,
    "meta_desc_min_length":  150,
    "meta_desc_max_length":  160,
    "rules": {
      "check_h1":               true,
      "check_meta_description": true,
      "check_title_length":     true,
      "check_canonical":        true
    }
  },
  "performance": {
    "strategy":               "mobile",
    "lighthouse_concurrency": 3,
    "thresholds": {
      "ttfb_ms":   600,
      "lcp_ms":    2500,
      "cls":       0.1,
      "score_min": 50
    }
  },
  "security": {
    "check_ssl":      true,
    "check_headers":  true,
    "ssl_days_warning": 30,
    "required_headers": [
      "Strict-Transport-Security",
      "Content-Security-Policy",
      "X-Frame-Options",
      "X-Content-Type-Options"
    ]
  }
}